# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# Production MongoDB Atlas URI example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/quickbite?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/quickbite

# Security Configuration
APP_KEY=super_secret_jwt_key_quickbite_production_32chars_min
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (Comma separated for multiple origins, or *)
CORS_ORIGIN=*

# Rate Limiting (Requests per 15 min window)
RATE_LIMIT_MAX=100

